---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Bartosz Rzepkowski';
const description = 'Big data analyst and AI-safety researcher with a PhD in theoretical physics.';
const permalink = Astro.site.href;

const experience = [
  {
    org: 'Integer Group Services',
    role: 'Big Data Analyst',
    when: '2024 — now',
    detail: 'Complex data analysis with PySpark on Databricks.',
  },
  {
    org: 'QuantUp',
    role: 'Junior Data Scientist',
    when: '2022 — 2024',
    detail: 'Machine-learning models for business problems: an LLM RAG chatbot (LangChain + OpenAI API), Stable Diffusion model fine-tuning, and dockerized FastAPI service development.',
  },
  {
    org: 'Comarch',
    role: 'BSS Consultant',
    when: '2016 — 2017',
    detail: 'Java application development with Spring and Hibernate.',
  },
];

const education = [
  {
    org: 'PhD in Theoretical Physics',
    role: 'Wrocław University of Science and Technology · University of Kent',
    when: '2018 — 2023',
    detail: 'Thesis: <a href="https://bip.pwr.edu.pl/d/mGBUJIA1JEFR3CkV0ShNDPF0WUXJuWU9OSzU-WAJVQG9QD0JpSBsjFW8SBDRKTxMQXxsDFzwdT1gdNxRUSlUXEgpTWHFVD3oOZwFEdEoQQxUWSFEOPgIDFks4/rozprawa.pdf" target="_blank" rel="noopener">Simulation of two-dimensional strongly correlated systems via tree-like isometric tensor networks: from physical models to quantum computers <span class="tarrow">→</span></a><br />Supervisors: Arkadiusz Wójs, Gunnar Möller.<br />Funded by the InterDok project.',
  },
  {
    org: "Master's in Computer Science",
    role: 'Wrocław University of Science and Technology',
    when: '2017 — 2018',
    detail: 'Thesis: Implementation of algorithms on a quantum computer.',
  },
  {
    org: 'Engineer in Computer Science',
    role: 'Wrocław University of Science and Technology · Lappeenranta University of Technology (ERASMUS+)',
    when: '2013 — 2017',
    detail: 'Thesis: Controlling a computer model with the use of a neural network.',
  },
];

const safety = [
  {
    when: '2026',
    org: 'Pivotal',
    orgHref: 'https://www.pivotal-research.org/',
    programme: 'AI Safety Fellowship',
    detail: 'Project: Deep models reveal better strategies for superposition.<br />Mentors: Logan Riggs Smith and Thomas Dooms.',
  },
  { when: '2026', org: 'Iliad', orgHref: 'https://www.iliad.ac/', programme: 'Intensive', detail: '' },
  { when: '2026', org: 'CAMBRIA', orgHref: 'https://www.cbai.ai/cambria', programme: '', detail: '' },
  { when: '2026', org: 'ML4Good', orgHref: 'https://ml4good.org/', programme: 'Technical Programme', detail: '' },
  { when: '2026', org: 'BlueDot Impact', orgHref: '', programme: 'Technical AI Safety Course', detail: '' },
  { when: '2025', org: 'BlueDot Impact', orgHref: '', programme: 'AGI Strategy Course', detail: '' },
];

const publications = [
  {
    venue: 'Physical Review A 108, 012412',
    year: '2023',
    title: 'Signature of quantumness in pure decoherence control',
    blurb: 'A decoherence-control scheme built on an intermediate qubit measurement: under broad conditions it recovers coherence on average, and when coherence is lost instead, that loss is a strictly quantum effect of non-commuting qubit–environment dynamics.',
    href: 'https://doi.org/10.1103/PhysRevA.108.012412',
  },
  {
    venue: 'Quantum Information Processing 20, 1',
    year: '2021',
    title: 'A scheme for direct detection of qubit–environment entanglement generated during qubit pure dephasing',
    blurb: 'A scheme for detecting the entanglement a qubit builds with its environment during pure dephasing, using only operations and measurements on the qubit itself — all within reach of current experiments.',
    href: 'https://doi.org/10.1007/s11128-020-02935-8',
  },
];
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="container about">
    <header>
      <img class="portrait" src="/assets/portrait.jpg" alt="Portrait of Bartosz Rzepkowski" width="180" height="240" />
      <div>
        <h3>Bartosz Rzepkowski</h3>
        <p class="tagline">Big Data Analyst · AI-Safety Researcher · PhD in Theoretical Physics</p>
        <p class="contact">
          <a href="mailto:bartosz.rzepkowski94@gmail.com">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <span>Email</span>
          </a>
          <a href="https://github.com/brzepkowski" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            <span>GitHub</span>
          </a>
          <a href="https://pl.linkedin.com/in/bartosz-rzepkowski-phd-a1065b155" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a href="https://scholar.google.com/citations?user=6JvJDlQAAAAJ" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
            <span>Scholar</span>
          </a>
        </p>
      </div>
    </header>

    <p>
      Hi! I'm Bartosz. I have a Master's in Computer Science and a PhD in
      Theoretical Physics, most of which I spent tangled up in tensor networks.
      Now I'm putting that experience to work in mechanistic interpretability,
      focusing on models that can be expressed as — you guessed it — tensor
      networks. I'm also studying superposition again, just the non-quantum kind
      this time, which unfortunately involves no cats whatsoever.
    </p>

    <p>
      In my free time I like to climb boulders, lift heavy things (mostly kettlebells!),
      read a good book, or "relax" with a souls-like game.
    </p>

    <h2>Experience</h2>
    {experience.map(e => (
      <div class="entry">
        <div class="body">
          <div class="line">
            <span class="what">{e.role} · {e.org}</span>
            <span class="when">{e.when}</span>
          </div>
          <p class="detail small">{e.detail}</p>
        </div>
      </div>
    ))}

    <h2>Education</h2>
    {education.map(e => (
      <div class="entry">
        <div class="body">
          <div class="line">
            <span class="what">{e.org}</span>
            <span class="when">{e.when}</span>
          </div>
          <p class="sub">{e.role}</p>
          <p class="detail small" set:html={e.detail} />
        </div>
      </div>
    ))}

    <h2>AI safety</h2>
    {safety.map(e => (
      <div class="entry">
        <div class="body">
          <div class="line">
            <span class="what">
              {e.orgHref ? <a href={e.orgHref} target="_blank" rel="noopener">{e.org}</a> : e.org}{e.programme ? ` · ${e.programme}` : ''}
            </span>
            <span class="when">{e.when}</span>
          </div>
          {e.detail && <p class="detail small" set:html={e.detail} />}
        </div>
      </div>
    ))}

    <h2>Publications</h2>
    <div class="papers">
      {publications.map(p => (
        <a class="paper" href={p.href} target="_blank" rel="noopener">
          <span class="venue">{p.venue} · {p.year}</span>
          <span class="ptitle">{p.title}</span>
          <span class="blurb">{p.blurb}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 760px;
    margin: 0 auto;
  }

  header {
    display: flex;
    align-items: flex-start;
    gap: 2em;
    margin: 1.5em 0 2em;
  }

  .portrait {
    width: 180px;
    height: 240px;
    object-fit: cover;
    border-radius: 12px;
    flex-shrink: 0;
  }

  header h3 {
    font-size: 1.9em;
    line-height: 1;
    margin: 0 0 0.4em;
  }

  .tagline {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-weight: 600;
    margin: 0 0 0.8em;
  }

  .contact {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4em 1.2em;
    margin: 0;
  }

  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: 0.9em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact a:hover {
    color: var(--primary-color);
  }

  .contact svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .about > p {
    text-align: justify;
    font-size: 1.0em;
    hyphens: auto;
  }

  h2 {
    margin-top: 1.3em;
    margin-bottom: 0.6em;
    padding-top: 1.1em;
    border-top: 1px solid rgba(128, 128, 128, 0.2);
  }

  /* Experience & Education cards */
  .entry {
    display: flex;
    gap: 1.2em;
    margin-bottom: 1.4em;
  }

  .logo {
    flex: 0 0 60px;
    width: 60px;
    height: 60px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px;
    box-sizing: border-box;
  }

  .logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1em;
  }

  .what {
    font-weight: 700;
  }

  .what a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .what a:hover {
    color: var(--primary-color);
  }

  .sub {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 0.9em;
    margin: 0.15em 0 0;
  }

  .when {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: 0.9em;
    white-space: nowrap;
  }

  .detail {
    color: var(--text-secondary);
    margin: 0.35em 0 0;
    text-align: justify;
    hyphens: auto;
  }

  .detail.small {
    font-size: 0.85em;
  }

  .detail :global(a) {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .detail :global(a:hover) {
    color: var(--primary-color);
  }

  .detail :global(.tarrow) {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .detail :global(a:hover .tarrow) {
    transform: translateX(3px);
  }

  /* Publications — clickable cards */
  .papers {
    display: flex;
    flex-direction: column;
    gap: 0.8em;
  }

  .paper {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1em;
    padding: 1em 1.2em;
    border: 1px solid var(--text-secondary);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .paper:hover {
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }

  .venue {
    grid-column: 1;
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 0.8em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .ptitle {
    grid-column: 1;
    font-weight: 700;
    margin-top: 0.2em;
  }

  .blurb {
    grid-column: 1;
    color: var(--text-secondary);
    margin-top: 0.25em;
  }

  .arrow {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    color: var(--text-secondary);
    font-size: 1.3em;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .paper:hover .arrow {
    color: var(--primary-color);
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    header {
      flex-direction: column;
      text-align: center;
    }

    .line {
      flex-direction: column;
      gap: 0.1em;
    }
  }
</style>
